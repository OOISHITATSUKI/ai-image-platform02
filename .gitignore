# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# backups
/backups/

# Companion Live Action videos — large binary assets managed outside git.
# Sync to VPS via rsync; Admin upload writes directly on each environment.
public/companions/videos/
# User-uploaded companion avatars (timestamped filenames). The shipped
# placeholder defaults (name-1.jpg ... name-3.jpg) stay committed.
public/companions/avatars/*-17*.png
public/companions/avatars/*-17*.jpg
public/companions/avatars/*-17*.webp

# runtime data (managed by Supabase, not git)
data/users.json
data/credit_log.json
data/guest_generations.json
data/guest_images.json
data/demo_stats.json
data/images/
data/transactions.json
data/login_log.json
data/trusted_devices.json
data/registration_attempts.json
data/bans.json
data/saved_faces.json
data/inactivity_notified.json
