# Novita.ai Image Generation API
# Get your key at https://novita.ai/
NOVITA_API_KEY=sk_3ylWLv1jKic8_cJH3vPGcS7WRDNBTX6I6CLPtLJwX8A

# Together AI — prompt optimization (optional fallback)
# Get your key at https://api.together.xyz/
TOGETHER_API_KEY=your_together_api_key_here
TOGETHER_MODEL=Qwen/Qwen2.5-7B-Instruct-Turbo

# Novita LLM — companion chat (uses same NOVITA_API_KEY as image gen)
# Models: https://novita.ai/models/llm
NOVITA_CHAT_MODEL=meta-llama/llama-3.3-70b-instruct

# LLM Provider for prompt optimization: 'novita' (default), 'together', or 'claude'
LLM_PROVIDER=novita

# Fanvue OAuth (for DM auto-send)
FANVUE_CLIENT_ID=your_fanvue_client_id
FANVUE_CLIENT_SECRET=your_fanvue_client_secret
FANVUE_ACCESS_TOKEN=your_initial_access_token
FANVUE_REFRESH_TOKEN=your_initial_refresh_token
